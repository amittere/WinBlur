<Page x:Class="WinBlur.App.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom"
                    Grid.Row="0"
                    Margin="0,0,0,30">
            <Image Source="Assets/AppLogo.svg"
                   Width="100"
                   Height="100"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,10"/>
            <TextBlock Text="WinBlur"
                       HorizontalAlignment="Center"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="A modern NewsBlur client for Windows"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}"/>
        </StackPanel>
        
        <StackPanel x:Name="splashPanel"
                    Orientation="Vertical"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToCollapsedConverter}}">
            <Button Content="Sign in with NewsBlur"
                    MinWidth="200"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LoginButton_Click"/>
            <HyperlinkButton Content="What's NewsBlur?"
                             NavigateUri="http://www.newsblur.com"
                             HorizontalAlignment="Center"
                             FontSize="14"/>
        </StackPanel>

        <StackPanel x:Name="loginPanel"
                    Orientation="Vertical"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SignInProgressText}" Margin="0,0,0,2"/>
                <muxc:ProgressRing 
                    Width="16"
                    Height="16"
                    Foreground="{StaticResource SystemAccentColor}"
                    IsActive="{Binding IsSigningIn}"/>
            </StackPanel>
            <Button Grid.Column="0"
                    Content="Cancel"
                    MinWidth="200"
                    HorizontalAlignment="Center"
                    Click="LoginCancelButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
